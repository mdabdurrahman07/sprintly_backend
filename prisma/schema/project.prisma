model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  managerId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  manager Manager         @relation(fields: [managerId], references: [id])
  members ProjectMember[]
  tasks   Task[]

  @@index([managerId])
  @@index([status])
  @@map("projects")
}
